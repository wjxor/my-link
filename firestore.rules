rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 공통 검증 함수
    // ==========================================
    function isValidString(text, min, max) {
      return text is string && text.size() >= min && text.size() <= max;
    }
    
    function isValidUrl(url) {
      return url is string && url.matches('^https?://.*');
    }

    function isValidDisplayName(name) {
      // 영문, 숫자, 밑줄, 하이픈, 마침표만 허용 (URL 슬러그용)
      return isValidString(name, 3, 20) && name.matches('^[a-zA-Z0-9_.-]+$');
    }

    // ==========================================
    // 1. 유저 프로필 문서 (users/{userId})
    // ==========================================
    match /users/{userId} {
      
      // 누구나 프로필 조회 가능
      allow read: if true;
      
      // 본인 확인 함수
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // 프로필 데이터 검증 함수
      function isValidProfileData() {
        let reqData = request.resource.data;
        let isDisplayNameValid = !reqData.keys().hasAll(['displayName']) || isValidDisplayName(reqData.displayName);
        let isUsernameValid = !reqData.keys().hasAll(['username']) || isValidString(reqData.username, 1, 30);
        return isDisplayNameValid && isUsernameValid;
      }
      
      // 프로필 생성
      allow create: if isOwner() && isValidProfileData();
      
      // 프로필 삭제
      allow delete: if isOwner();
      
      // 프로필 수정: 
      // 1) 본인이 유효한 데이터로 수정하되 displayName은 변경 불가, 또는
      // 2) 누구나(방문자) 조회수(visitorCount) 필드만 1 증가시키는 경우 허용
      allow update: if (isOwner() && isValidProfileData() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName']))
                    || (
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitorCount'])
                      && request.resource.data.visitorCount == resource.data.visitorCount + 1
                    );

      // ==========================================
      // 2. 유저의 링크 모음 (users/{userId}/links/{linkId})
      // ==========================================
      match /links/{linkId} {
        
        // 누구나 링크 목록 조회 가능
        allow read: if true;
        
        // 링크 데이터 검증 함수
        function isValidLinkData() {
          let reqData = request.resource.data;
          let isTitleValid = !reqData.keys().hasAll(['title']) || isValidString(reqData.title, 1, 100);
          let isUrlValid = !reqData.keys().hasAll(['url']) || isValidUrl(reqData.url);
          return isTitleValid && isUrlValid;
        }

        // 링크 생성
        allow create: if isOwner() && isValidLinkData();
        
        // 링크 삭제
        allow delete: if isOwner();

        // 링크 수정:
        // 1) 본인이 유효한 데이터로 수정하거나,
        // 2) 누구나(방문자) 클릭수(clickCount) 필드만 1 증가시키는 경우 허용
        allow update: if (isOwner() && isValidLinkData())
                      || (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount'])
                        && request.resource.data.clickCount == resource.data.clickCount + 1
                      );
      }
    }
    
    // ==========================================
    // 3. 닉네임(displayName) 중복 방지를 위한 컬렉션
    // ==========================================
    // 사용자는 가입 시 자신의 displayName을 문서 ID로 하는 usernames 문서를 생성해야 함 (트랜잭션/배치 사용)
    match /usernames/{username} {
      allow read: if true;
      // 생성: 로그인된 상태에서 자신의 uid를 포함해 생성
      allow create: if request.auth != null 
                    && request.resource.data.uid == request.auth.uid;
      // 삭제: 본인의 uid가 기록된 문서만 삭제 가능
      allow delete: if request.auth != null 
                    && resource.data.uid == request.auth.uid;
    }
  }
}
